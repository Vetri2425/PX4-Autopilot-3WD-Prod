#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# DYX 3WD production airframe: generic differential rover.
param set-default SYS_AUTOSTART 50000

# DYX 3WD production UM982: use the NMEA driver; never probe it as u-blox.
param set-default GPS_1_PROTOCOL 6

# uXRCE-DDS client over Ethernet to the Jetson agent at 10.41.10.1:8888
# (PX4 eth0 is static 10.41.10.2/24, see nuttx-config/nsh/defconfig).
param set-default UXRCE_DDS_CFG 1000
param set-default UXRCE_DDS_AG_IP 170461697
param set-default UXRCE_DDS_PRT 8888

# By disabling all 3 INA modules, we use the
# i2c_launcher instead.
param set-default SENS_EN_INA238 0
param set-default SENS_EN_INA228 0
param set-default SENS_EN_INA226 0

# Jetson <-> PX4 is Ethernet + uXRCE-DDS only: no MAVLink instance on Ethernet.
# QGC, parameters and flashing go over USB (maintenance interface).
param set-default MAV_2_CONFIG 0
param set-default MAV_2_BROADCAST 1
param set-default MAV_2_MODE 0
param set-default MAV_2_RADIO_CTL 0
param set-default MAV_2_RATE 100000
param set-default MAV_2_REMOTE_PRT 14550
param set-default MAV_2_UDP_PRT 14550

safety_button start
